{
  "name": "audio-lab",
  "displayName": "Audio Lab",
  "description": "Transcribe audio files using Lemonade",
  "publisher": "lanly-dev",
  "version": "0.0.4",
  "sponsor": {
    "url": "https://github.com/sponsors/lanly-dev"
  },
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "audio",
    "captions",
    "lab",
    "lemon",
    "lemonade",
    "transcription",
    "subtitle",
    "SRT",
    "VTT",
    "whisper"
  ],
  "icon": "media/audio-lab.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "audio-lab-activity-bar",
          "title": "AudioLab",
          "icon": "media/audio-lab-icon.svg"
        }
      ]
    },
    "views": {
      "audio-lab-activity-bar": [
        {
          "id": "lemonadeStatus",
          "name": "Lemonade Server Status",
          "icon": "$(server)"
        }
      ]
    },
    "commands": [
      {
        "command": "audio-lab.changeServerUrl",
        "title": "AudioLab: Change Lemonade Server URL",
        "icon": "$(edit)"
      },
      {
        "command": "audio-lab.createSubtitles",
        "title": "AudioLab: Create Subtitles From File Chooser"
      },
      {
        "command": "audio-lab.openServerUrl",
        "title": "AudioLab: Open Server URL in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "audio-lab.openSettings",
        "title": "AudioLab: Open Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "audio-lab.refreshServerStatus",
        "title": "AudioLab: Refresh Lemonade Server Status",
        "icon": "$(refresh)"
      },
      {
        "command": "audio-lab.transcribeAudioFile",
        "title": "AudioLab: Transcribe Audio From File Chooser"
      },
      {
        "command": "audio-lab.ncp.speakTextFile",
        "title": "Generate Speech From Text File"
      },
      {
        "command": "audio-lab.ncp.speakSelection",
        "title": "Generate Speech Of The Selection"
      },
      {
        "command": "audio-lab.ncp.speakEditorContent",
        "title": "Generate Speech Of The Editor Content"
      },
      {
        "command": "audio-lab.ncp.createSubtitles",
        "title": "Create Subtitles"
      },
      {
        "command": "audio-lab.ncp.deleteMediaFile",
        "title": "Delete"
      },
      {
        "command": "audio-lab.ncp.revealInExplorer",
        "title": "Reveal in Explorer"
      },
      {
        "command": "audio-lab.ncp.transcribeAudioItem",
        "title": "Transcribe"
      },
      {
        "command": "audio-lab.ncp.toggleShowOtherModels",
        "title": "Show Unrelated Models",
        "icon": "$(eye-closed)"
      },
      {
        "command": "audio-lab.ncp.toggleHideOtherModels",
        "title": "Hide Unrelated Models",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "audio-lab.ncp.revealInExplorer",
          "when": "false"
        },
        {
          "command": "audio-lab.ncp.deleteMediaFile",
          "when": "false"
        },
        {
          "command": "audio-lab.ncp.transcribeAudioItem",
          "when": "false"
        },
        {
          "command": "audio-lab.ncp.createSubtitles",
          "when": "false"
        },
        {
          "command": "audio-lab.ncp.toggleShowOtherModels",
          "when": "false"
        },
        {
          "command": "audio-lab.ncp.toggleHideOtherModels",
          "when": "false"
        },
        {
          "command": "audio-lab.ncp.speakTextFile",
          "when": "false"
        },
        {
          "command": "audio-lab.ncp.speakSelection",
          "when": "false"
        },
        {
          "command": "audio-lab.ncp.speakEditorContent",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "audio-lab.changeServerUrl",
          "when": "view == lemonadeStatus && viewItem == LEMONADE_SERVER_URL",
          "group": "inline"
        },
        {
          "command": "audio-lab.openServerUrl",
          "when": "view == lemonadeStatus && viewItem == LEMONADE_SERVER_URL",
          "group": "inline"
        },
        {
          "command": "audio-lab.ncp.toggleShowOtherModels",
          "when": "view == lemonadeStatus && viewItem == MODELS_HEADER_TRANSCRIPTION_ONLY",
          "group": "inline"
        },
        {
          "command": "audio-lab.ncp.toggleHideOtherModels",
          "when": "view == lemonadeStatus && viewItem == MODELS_HEADER_WITH_UNRELATED",
          "group": "inline"
        },
        {
          "command": "audio-lab.ncp.revealInExplorer",
          "when": "view == lemonadeStatus && (viewItem == AUDIO_ITEM || viewItem == AUDIO_ITEM_TRANSCRIBING || viewItem == SUBTITLE_ITEM || viewItem == TEXT_ITEM || viewItem == MEDIA_DIRECTORY)",
          "group": "1_modification"
        },
        {
          "command": "audio-lab.ncp.transcribeAudioItem",
          "when": "view == lemonadeStatus && viewItem == AUDIO_ITEM",
          "group": "1_modification@2"
        },
        {
          "command": "audio-lab.ncp.createSubtitles",
          "when": "view == lemonadeStatus && viewItem == AUDIO_ITEM",
          "group": "1_modification@3"
        },
        {
          "command": "audio-lab.ncp.deleteMediaFile",
          "when": "view == lemonadeStatus && (viewItem == AUDIO_ITEM || viewItem == SUBTITLE_ITEM || viewItem == TEXT_ITEM)",
          "group": "1_modification@4"
        },
        {
          "command": "audio-lab.ncp.speakTextFile",
          "when": "view == lemonadeStatus && viewItem == TEXT_ITEM",
          "group": "2_generation"
        }
      ],
      "editor/context": [
        {
          "command": "audio-lab.ncp.speakSelection",
          "when": "editorHasSelection",
          "group": "2_generation"
        },
        {
          "command": "audio-lab.ncp.speakEditorContent",
          "when": "editorTextFocus && !editorHasSelection",
          "group": "2_generation"
        }
      ],
      "view/title": [
        {
          "command": "audio-lab.openSettings",
          "when": "view == lemonadeStatus",
          "group": "navigation"
        },
        {
          "command": "audio-lab.refreshServerStatus",
          "when": "view == lemonadeStatus",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Audio Lab",
      "properties": {
        "audio-lab.pickedSttModel": {
          "type": "string",
          "default": null,
          "description": "Currently picked model for transcription"
        },
        "audio-lab.pickedTtsModel": {
          "type": "string",
          "default": null,
          "description": "Currently picked model for text-to-speech"
        },
        "audio-lab.lemonadeServerUrl": {
          "type": "string",
          "default": "http://localhost:13305",
          "description": "Lemonade Server URL"
        },
        "audio-lab.transcriptionModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "whisper"
          ],
          "description": "Model ids (or id substrings, case-insensitive) allowed for transcription. Only models matching this list are shown as selectable for transcription. Add 'moonshine' (or a full model id) to allow other models. Leave empty to show none."
        },
        "audio-lab.ttsModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "kokoro",
            "moss",
            "tts",
            "voicegen"
          ],
          "description": "Model ids (or id substrings, case-insensitive) allowed for text-to-speech. Models matching this list (e.g. kokoro-v1, MOSS-TTS-Local, MOSS-VoiceGen, OpenMOSS-TTS) are shown under the Tts section. Leave empty to show none."
        },
        "audio-lab.ttsVoice": {
          "type": "string",
          "default": "coral",
          "description": "Voice to use for text-to-speech (e.g. coral, alloy). Passed as `voice` to POST /v1/audio/speech."
        },
        "audio-lab.ttsFormat": {
          "type": "string",
          "enum": [
            "wav",
            "mp3"
          ],
          "default": "wav",
          "description": "Audio format for generated speech. Passed as `response_format` to POST /v1/audio/speech."
        },
        "audio-lab.subtitleFormat": {
          "type": "string",
          "enum": [
            "srt",
            "vtt"
          ],
          "default": "srt",
          "description": "Subtitle format to use when creating subtitles from audio. SRT is the most widely supported subtitle format; WebVTT is useful for web playback."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "vsce-package": "vsce package",
    "efix": "eslint . --fix"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.2",
    "@types/vscode": "^1.138.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "ovsx": "^1.2.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanly-dev/vscode-audio-lab.git"
  },
  "bugs": {
    "url": "https://github.com/lanly-dev/vscode-audio-lab/issues"
  },
  "license": "MIT"
}
