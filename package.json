{
  "name": "audio-lab",
  "displayName": "Audio Lab",
  "description": "Audio transcription and speech generation using Lemonade 🍋",
  "publisher": "lanly-dev",
  "version": "0.0.5",
  "sponsor": {
    "url": "https://github.com/sponsors/lanly-dev"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "audio",
    "captions",
    "lab",
    "lemon",
    "lemonade",
    "transcription",
    "subtitle",
    "SRT",
    "VTT",
    "whisper"
  ],
  "icon": "media/audio-lab.png",
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "audio-lab-activity-bar",
          "title": "AudioLab",
          "icon": "media/audio-lab-icon.svg"
        }
      ]
    },
    "views": {
      "audio-lab-activity-bar": [
        {
          "id": "AUDIO_LAB_DASHBOARD",
          "name": "Dashboard",
          "icon": "$(server)"
        }
      ]
    },
    "commands": [
      {
        "command": "audio-lab.changeServerUrl",
        "title": "AudioLab: Change Lemonade Server URL",
        "icon": "$(edit)"
      },
      {
        "command": "audio-lab.createSubtitles",
        "title": "AudioLab: Create Subtitles From File Chooser"
      },
      {
        "command": "audio-lab.ncp.genSpeechFileItem",
        "title": "Generate Audio File"
      },
      {
        "command": "audio-lab.ncp.genSpeechSelection",
        "title": "Generate Audio File From Selection"
      },
      {
        "command": "audio-lab.ncp.genSpeechEditor",
        "title": "Generate Audio File From Editor Content"
      },
      {
        "command": "audio-lab.openServerUrl",
        "title": "AudioLab: Open Server URL in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "audio-lab.openSettings",
        "title": "AudioLab: Open Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "audio-lab.refreshServerStatus",
        "title": "AudioLab: Refresh Lemonade Server Status",
        "icon": "$(refresh)"
      },
      {
        "command": "audio-lab.transcribeAudioFile",
        "title": "AudioLab: Transcribe Audio From File Chooser"
      },
      {
        "command": "audio-lab.ncp.createSubtitlesItem",
        "title": "Create Subtitles"
      },
      {
        "command": "audio-lab.ncp.deleteMediaFileItem",
        "title": "Delete"
      },
      {
        "command": "audio-lab.ncp.revealInExplorer",
        "title": "Reveal in Explorer"
      },
      {
        "command": "audio-lab.ncp.toggleShowOtherModels",
        "title": "Show Unrelated Models",
        "icon": "$(eye-closed)"
      },
      {
        "command": "audio-lab.ncp.toggleHideOtherModels",
        "title": "Hide Unrelated Models",
        "icon": "$(eye)"
      },
      {
        "command": "audio-lab.ncp.transcribeAudioItem",
        "title": "Transcribe"
      },
      {
        "command": "audio-lab.ncp.setVoiceRefItem",
        "title": "Set as Voice Reference",
        "icon": "$(microphone)"
      },
      {
        "command": "audio-lab.ncp.clearVoiceRefItem",
        "title": "Clear Voice Reference",
        "icon": "$(close-all)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "audio-lab.ncp.createSubtitlesItem",
          "when": "false"
        },
        {
          "command": "audio-lab.ncp.deleteMediaFileItem",
          "when": "false"
        },
        {
          "command": "audio-lab.ncp.genSpeechFileItem",
          "when": "false"
        },
        {
          "command": "audio-lab.ncp.genSpeechSelection",
          "when": "false"
        },
        {
          "command": "audio-lab.ncp.genSpeechEditor",
          "when": "false"
        },
        {
          "command": "audio-lab.ncp.revealInExplorer",
          "when": "false"
        },
        {
          "command": "audio-lab.ncp.toggleShowOtherModels",
          "when": "false"
        },
        {
          "command": "audio-lab.ncp.toggleHideOtherModels",
          "when": "false"
        },
        {
          "command": "audio-lab.ncp.transcribeAudioItem",
          "when": "false"
        },
        {
          "command": "audio-lab.ncp.setVoiceRefItem",
          "when": "false"
        },
        {
          "command": "audio-lab.ncp.clearVoiceRefItem",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "audio-lab.changeServerUrl",
          "when": "view == AUDIO_LAB_DASHBOARD && viewItem == LEMONADE_SERVER_URL",
          "group": "inline"
        },
        {
          "command": "audio-lab.openServerUrl",
          "when": "view == AUDIO_LAB_DASHBOARD && viewItem == LEMONADE_SERVER_URL",
          "group": "inline"
        },
        {
          "command": "audio-lab.ncp.toggleShowOtherModels",
          "when": "view == AUDIO_LAB_DASHBOARD && viewItem == MODELS_HEADER_TRANSCRIPTION_ONLY",
          "group": "inline"
        },
        {
          "command": "audio-lab.ncp.toggleHideOtherModels",
          "when": "view == AUDIO_LAB_DASHBOARD && viewItem == MODELS_HEADER_WITH_UNRELATED",
          "group": "inline"
        },
        {
          "command": "audio-lab.ncp.revealInExplorer",
          "when": "view == AUDIO_LAB_DASHBOARD && (viewItem == AUDIO_ITEM || viewItem == AUDIO_ITEM_TRANSCRIBING || viewItem == SUBTITLE_ITEM || viewItem == TEXT_ITEM || viewItem == MEDIA_DIRECTORY)",
          "group": "1_modification"
        },
        {
          "command": "audio-lab.ncp.transcribeAudioItem",
          "when": "view == AUDIO_LAB_DASHBOARD && viewItem == AUDIO_ITEM",
          "group": "1_modification@2"
        },
        {
          "command": "audio-lab.ncp.createSubtitlesItem",
          "when": "view == AUDIO_LAB_DASHBOARD && viewItem == AUDIO_ITEM",
          "group": "1_modification@3"
        },
        {
          "command": "audio-lab.ncp.genSpeechFileItem",
          "when": "view == AUDIO_LAB_DASHBOARD && viewItem == TEXT_ITEM",
          "group": "1_modification@4"
        },
        {
          "command": "audio-lab.ncp.deleteMediaFileItem",
          "when": "view == AUDIO_LAB_DASHBOARD && (viewItem == AUDIO_ITEM || viewItem == SUBTITLE_ITEM || viewItem == TEXT_ITEM)",
          "group": "1_modification@5"
        },
        {
          "command": "audio-lab.ncp.setVoiceRefItem",
          "when": "view == AUDIO_LAB_DASHBOARD && viewItem == AUDIO_ITEM",
          "group": "1_generation@6"
        },
        {
          "command": "audio-lab.ncp.clearVoiceRefItem",
          "when": "view == AUDIO_LAB_DASHBOARD && viewItem == TTS_PICKED_WITH_REF",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "audio-lab.ncp.genSpeechSelection",
          "when": "editorHasSelection",
          "group": "1_generation"
        },
        {
          "command": "audio-lab.ncp.genSpeechEditor",
          "when": "editorTextFocus && !editorHasSelection",
          "group": "1_generation"
        }
      ],
      "view/title": [
        {
          "command": "audio-lab.openSettings",
          "when": "view == AUDIO_LAB_DASHBOARD",
          "group": "navigation"
        },
        {
          "command": "audio-lab.refreshServerStatus",
          "when": "view == AUDIO_LAB_DASHBOARD",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Audio Lab",
      "properties": {
        "audio-lab.pickedSttModel": {
          "type": "string",
          "default": null,
          "description": "Currently picked model for transcription"
        },
        "audio-lab.pickedTtsModel": {
          "type": "string",
          "default": null,
          "description": "Currently picked model for text-to-speech"
        },
        "audio-lab.lemonadeServerUrl": {
          "type": "string",
          "default": "http://localhost:13305",
          "description": "Lemonade Server URL"
        },
        "audio-lab.transcriptionModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "whisper"
          ],
          "description": "Model ids (or id substrings, case-insensitive) allowed for transcription. Only models matching this list are shown as selectable for transcription. Add 'moonshine' (or a full model id) to allow other models. Leave empty to show none."
        },
        "audio-lab.ttsModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "kokoro",
            "moss"
          ],
          "description": "Model ids (or id substrings, case-insensitive) allowed for text-to-speech. Models matching this list (e.g. kokoro-v1, MOSS-TTS-Local, MOSS-VoiceGen, OpenMOSS-TTS) are shown under the Tts section. Leave empty to show none."
        },
        "audio-lab.ttsVoiceKokoro": {
          "type": "string",
          "enum": [
            "alloy",
            "ash",
            "ballad",
            "cedar",
            "coral",
            "echo",
            "fable",
            "marin",
            "nova",
            "onyx",
            "sage",
            "shimmer",
            "verse"
          ],
          "default": "nova",
          "description": "Voice preset for Kokoro models (e.g. kokoro-v1). Overrides `audio-lab.ttsVoice` when a Kokoro model is selected. Voice list from Lemonade: https://github.com/lemonade-sdk/lemonade/blob/3f4a306b/src/app/src/renderer/tabs/TTSSettings.tsx"
        },
        "audio-lab.ttsRefVoice": {
          "type": "string",
          "default": null,
          "description": "Path to a reference WAV audio file for voice cloning. Applies to voice-cloning-capable models only (MOSS); Kokoro cannot clone voices and always uses `audio-lab.ttsVoiceKokoro`, ignoring this reference. The reference file is sent to the Lemonade server with each TTS request."
        },
        "audio-lab.ttsFormat": {
          "type": "string",
          "enum": [
            "wav",
            "mp3"
          ],
          "default": "wav",
          "description": "Audio format for the generated audio file. Passed as `response_format` to POST /v1/audio/speech."
        },
        "audio-lab.subtitleFormat": {
          "type": "string",
          "enum": [
            "srt",
            "vtt"
          ],
          "default": "srt",
          "description": "Subtitle format to use when creating subtitles from audio. SRT is the most widely supported subtitle format; WebVTT is useful for web playback."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "vsce-package": "vsce package",
    "efix": "eslint . --fix"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "ovsx": "^1.2.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanly-dev/vscode-audio-lab.git"
  },
  "bugs": {
    "url": "https://github.com/lanly-dev/vscode-audio-lab/issues"
  },
  "license": "MIT"
}